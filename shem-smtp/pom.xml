<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.shem</groupId>
    <artifactId>shem-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>shem-smtp</artifactId>
  <name>Shem SMTP Adapter</name>
  <description>Inbound SMTP (port 25) over Apache James protocol handlers, delivering to locked mailboxes (ADR 0009).</description>
  <dependencies>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-delivery</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-policy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james.protocols</groupId>
      <artifactId>protocols-smtp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james.protocols</groupId>
      <artifactId>protocols-netty</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-mailbox</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-store</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- Creates the integration tests' java.io.tmpdir (the JVM requires it to exist). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>it-tmpdir</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/it-tmp</outputDirectory>
              <resources>
                <resource>
                  <directory>src/it-tmp</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>-XX:-HeapDumpOnOutOfMemoryError -XX:-CreateCoredumpOnCrash -Djava.io.tmpdir=${project.build.directory}/it-tmp</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
