<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.shem</groupId>
    <artifactId>shem-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>shem-http</artifactId>
  <name>Shem HTTP API</name>
  <description>HTTPS self-service and management API on the JDK HTTP server (ADR 0013).</description>
  <dependencies>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-mailbox</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.webauthn4j</groupId>
      <artifactId>webauthn4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-cbor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Tests set Host to exercise virtual-host routing (MTA-STS, port-80 redirects). -->
          <argLine>-XX:-HeapDumpOnOutOfMemoryError -XX:-CreateCoredumpOnCrash -Djdk.httpclient.allowRestrictedHeaders=host</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
