<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.shem</groupId>
    <artifactId>shem-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>shem-imap</artifactId>
  <name>Shem IMAP Adapter</name>
  <description>Apache James IMAP protocol over Shem's encrypted mailbox (ADR 0005).</description>
  <dependencies>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-mailbox</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james.protocols</groupId>
      <artifactId>protocols-imap</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james</groupId>
      <artifactId>james-server-protocols-imap4</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james</groupId>
      <artifactId>apache-james-mailbox-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james</groupId>
      <artifactId>apache-james-mailbox-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.james</groupId>
      <artifactId>event-bus-in-vm</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-store</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- A dedicated temp directory (set at JVM start; the JDK caches it) lets tests prove
               James never spills mail to temp files. -->
          <argLine>-XX:-HeapDumpOnOutOfMemoryError -XX:-CreateCoredumpOnCrash -Djava.io.tmpdir=${project.build.directory}/it-tmp</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
