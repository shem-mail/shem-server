<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.shem</groupId>
    <artifactId>shem-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>shem-app</artifactId>
  <name>Shem Application</name>
  <description>Runtime composition root, typed configuration, and command-line entry points.</description>

  <dependencies>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-delivery</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-mailbox</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-search</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-extract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-imap</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-smtp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-policy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-outbound</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-http</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>shem-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.shem.app.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
            <configuration>
              <outputFormat>json</outputFormat>
              <outputName>bom</outputName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
