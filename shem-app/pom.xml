<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.shem</groupId>
    <artifactId>shem-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>shem-app</artifactId>
  <name>Shem Application</name>
  <description>Runtime composition root, typed configuration, and command-line entry points.</description>

  <dependencies>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-store</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-delivery</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-mailbox</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-tls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-search</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-extract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-imap</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-smtp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-policy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-outbound</artifactId>
    </dependency>
    <dependency>
      <groupId>org.shem</groupId>
      <artifactId>shem-http</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>shem-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.shem.app.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <!-- License and notice files the shipped jars carry (Apache-2.0 section 4,
                 BSD/MIT attribution), reproduced next to the binary distribution. -->
            <id>unpack-third-party-notices</id>
            <phase>package</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <excludeGroupIds>org.shem</excludeGroupIds>
              <includes>META-INF/LICENSE*,META-INF/NOTICE*,META-INF/COPYING*,META-INF/*LICENSE*.txt,META-INF/*/LICENSE*,META-INF/*/NOTICE*,LICENSE*,NOTICE*</includes>
              <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
              <stripVersion>true</stripVersion>
              <stripType>true</stripType>
              <outputDirectory>${project.build.directory}/third-party</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Human-readable list of every shipped third-party artifact with its declared license. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>third-party-list</id>
            <phase>package</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/third-party</outputDirectory>
              <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
              <excludedScopes>test,provided,system</excludedScopes>
              <excludedGroups>^org\.shem$</excludedGroups>
              <sortArtifactByName>true</sortArtifactByName>
              <!-- Only write target/third-party; do not add it to the jar's resources. -->
              <generateBundle>false</generateBundle>
              <licenseMerges>
                <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache License 2.0|Apache 2.0|Apache 2|The Apache License, Version 2.0|Apache License Version 2.0|Apache-2.0 License</licenseMerge>
                <licenseMerge>MIT|MIT License|The MIT License|MIT license</licenseMerge>
              </licenseMerges>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- License/notice texts that some shipped jars omit (see src/third-party/README.md). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>supplementary-third-party-notices</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/third-party</outputDirectory>
              <resources>
                <resource>
                  <directory>src/third-party/licenses</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
            <configuration>
              <outputFormat>json</outputFormat>
              <outputName>bom</outputName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
